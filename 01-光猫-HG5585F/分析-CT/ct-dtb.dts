        npu@1e900000 {  /* phandle 0x35 */
            compatible = "airoha,en7581-npu";
            interrupts = < 0x0 0x7d 0x4 0x0 0x67 0x4 0x0 0x6d 0x4 0x0 0x71 0x4 0x0 0x75 0x4 0x0 0x86 0x4 0x0 0x87 0x4 0x0 0x88 0x4 0x0 0x89 0x4 0x0 0x76 0x4 0x0 0x77 0x4 0x0 0x78 0x4 0x0 0x79 0x4 0x0 0x7a 0x4 0x0 0x7b 0x4 >;
            memory-region = < &{/reserved-memory/npu-binary@84000000} >;
            memory-region-names = "binary";
            reg = < 0x0 0x1e900000 0x0 0x313000 >;
            status = "okay";
        };

        ethernet@1fb50000 {  /* phandle 0x36 */
            #address-cells = < &{/soc/interrupt-controller@9000000} >;
            #size-cells = < 0x0 >;
            airoha,npu = <0x35>;
            compatible = "airoha,en7581-eth";
            interrupts = < 0x0 0x25 0x4 0x0 0x37 0x4 0x0 0x38 0x4 0x0 0x39 0x4 0x0 0x26 0x4 0x0 0x3a 0x4 0x0 0x3b 0x4 0x0 0x3c 0x4 0x0 0x31 0x4 0x0 0x40 0x4 >;
            memory-region = < &{/reserved-memory/qdma0-buf@87000000} 0x3a >;
            memory-region-names = [71646d61302d6275660071646d61312d62756600];
            reg = < 0x0 0x1fb50000 0x0 0x2600 0x0 0x1fb54000 0x0 0x2000 0x0 0x1fb56000 0x0 0x2000 >;
            reg-names = [66650071646d61300071646d613100];
            reset-names = [66650070646d610071646d61007873692d6d616300687369302d6d616300687369312d6d6163006873692d6d6163007866702d6d616300];
            resets = < &{/soc/clock-controller@1fb00000} 0x2c 0x1d 0x1e 0x1d 0x1f 0x1d 0x6 0x1d 0xf 0x1d 0x10 0x1d 0x11 0x1d 0x1a >;
            status = "okay";

            ethernet@1 {  /* phandle 0x43 */
                compatible = "airoha,eth-mac";
                nvmem-cell-names = "mac-address";
                nvmem-cells = < &{/soc/nand-controller@1fa11000/nand@0/partitions/partition@20000/volumes/ubi-volume-factory/nvmem-layout/mac-address@2000} 0x1 >;
                phy-mode = "internal";
                reg = < 0x1 >;
                status = "okay";

                fixed-link {
                    full-duplex = <>;
                    pause = <>;
                    speed = <0x2710>;
                };
            };

            ethernet@2 {  /* phandle 0x21 */
                airoha,pon-data-path = <>;
                compatible = "airoha,eth-mac";
                nvmem-cell-names = "mac-address";
                nvmem-cells = < &{/soc/nand-controller@1fa11000/nand@0/partitions/partition@20000/volumes/ubi-volume-factory/nvmem-layout/mac-address@2000} 0x0 >;
                pcs-handle = <0x1e>;
                reg = < 0x2 >;
                status = "okay";
            };

            ethernet@4 {
                compatible = "airoha,eth-mac";
                nvmem-cell-names = "mac-address";
                nvmem-cells = < &{/soc/nand-controller@1fa11000/nand@0/partitions/partition@20000/volumes/ubi-volume-factory/nvmem-layout/mac-address@2000} >;
                openwrt,netdev-name = "lan1";
                pcs-handle = <0x3c>;
                phy-handle = <0x3d>;
                phy-mode = "2500base-x";
                reg = < 0x4 >;
                status = "okay";
            };
        };

        switch@1fb58000 {
            #address-cells = < &{/soc/interrupt-controller@9000000} >;
            #interrupt-cells = < &{/soc/interrupt-controller@9000000} >;
            #size-cells = < &{/soc/interrupt-controller@9000000} >;
            compatible = "airoha,en7581-switch";
            interrupt-controller = <>;
            interrupt-parent = <0x1>;
            interrupts = < 0x0 0x1f 0x4 >;
            pinctrl-0 = <0x3e>;
            pinctrl-names = "default";
            reg = < 0x0 0x1fb58000 0x0 0x8000 >;
            resets = < &{/soc/clock-controller@1fb00000} 0x2e >;
            status = "okay";

            ports {
                #address-cells = < &{/soc/interrupt-controller@9000000} >;
                #size-cells = < 0x0 >;

                port@1 {
                    phy-handle = <0x3f>;
                    phy-mode = "internal";
                    reg = < 0x1 >;
                    status = "disabled";
                };

                port@2 {
                    label = "lan2";
                    phy-handle = <0x40>;
                    phy-mode = "internal";
                    reg = < 0x2 >;
                    status = "okay";
                };

                port@3 {
                    label = "lan3";
                    phy-handle = <0x41>;
                    phy-mode = "internal";
                    reg = < 0x3 >;
                    status = "okay";
                };

                port@4 {
                    label = "lan4";
                    phy-handle = <0x42>;
                    phy-mode = "internal";
                    reg = < 0x4 >;
                    status = "okay";
                };

                port@6 {
                    ethernet = <0x43>;
                    phy-mode = "internal";
                    reg = < 0x6 >;

                    fixed-link {
                        full-duplex = <>;
                        pause = <>;
                        speed = <0x2710>;
                    };
                };
            };

            mdio {
                #address-cells = < &{/soc/interrupt-controller@9000000} >;
                #size-cells = < 0x0 >;

                ethernet-phy@9 {  /* phandle 0x3f */
                    compatible = "ethernet-phy-ieee802.3-c22";
                    phy-mode = "internal";
                    reg = < 0x9 >;
                    status = "disabled";

                    leds {
                        #address-cells = < &{/soc/interrupt-controller@9000000} >;
                        #size-cells = < 0x0 >;

                        led@0 {
                            reg = < 0x0 >;
                            status = "disabled";
                        };

                        led@1 {
                            reg = < 0x1 >;
                            status = "disabled";
                        };
                    };
                };

                ethernet-phy@a {  /* phandle 0x40 */
                    compatible = "ethernet-phy-ieee802.3-c22";
                    phy-mode = "internal";
                    reg = < 0xa >;
                    status = "okay";

                    leds {
                        #address-cells = < &{/soc/interrupt-controller@9000000} >;
                        #size-cells = < 0x0 >;

                        led@0 {
                            reg = < 0x0 >;
                            status = "disabled";
                        };

                        led@1 {
                            reg = < 0x1 >;
                            status = "disabled";
                        };
                    };
                };

                ethernet-phy@b {  /* phandle 0x41 */
                    compatible = "ethernet-phy-ieee802.3-c22";
                    phy-mode = "internal";
                    reg = < 0xb >;
                    status = "okay";

                    leds {
                        #address-cells = < &{/soc/interrupt-controller@9000000} >;
                        #size-cells = < 0x0 >;

                        led@0 {
                            reg = < 0x0 >;
                            status = "disabled";
                        };

                        led@1 {
                            reg = < 0x1 >;
                            status = "disabled";
                        };
                    };
                };

                ethernet-phy@c {  /* phandle 0x42 */
                    compatible = "ethernet-phy-ieee802.3-c22";
                    phy-mode = "internal";
                    reg = < 0xc >;
                    status = "okay";

                    leds {
                        #address-cells = < &{/soc/interrupt-controller@9000000} >;
                        #size-cells = < 0x0 >;

                        led@0 {
                            reg = < 0x0 >;
                            status = "disabled";
                        };

                        led@1 {
                            reg = < 0x1 >;
                            status = "disabled";
                        };
                    };
                };

                ethernet-phy@7 {  /* phandle 0x3d */
                    compatible = "ethernet-phy-id67c9.de10";
                    reg = < 0x7 >;
                    reset-assert-us = <0x186a0>;
                    reset-deassert-us = <0x186a0>;
                    reset-gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x22 0x1 >;
                };
            };
        };
    };

    aliases {
        led-boot = "/leds/led-0";
        led-failsafe = "/leds/led-0";
        led-running = "/leds/led-0";
        led-upgrade = "/leds/led-0";
        serial0 = "/soc/serial@1fbf0000";
    };

    memory@80000000 {
        device_type = "memory";
        reg = < 0x0 0x80000000 0x0 0x20000000 >;
    };

    regulator-usb-3p3v {  /* phandle 0x25 */
        compatible = "regulator-fixed";
        regulator-always-on = <>;
        regulator-boot-on = <>;
        regulator-max-microvolt = <0x325aa0>;
        regulator-min-microvolt = <0x325aa0>;
        regulator-name = "usb-3.3V";
    };

    keys {
        compatible = "gpio-keys";

        key-reset {
            debounce-interval = <0x3c>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x23 0x1 >;
            label = "reset";
            linux,code = <0x198>;
        };

        key-wps {
            debounce-interval = <0x3c>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x4 0x1 >;
            label = "wps";
            linux,code = <0x211>;
        };

        key-rfkill {
            debounce-interval = <0x3c>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x3 0x1 >;
            label = "rfkill";
            linux,code = <0xf7>;
        };
    };

    leds {
        compatible = "gpio-leds";

        led-0 {
            color = <0x3>;
            function = "power";
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0xd 0x1 >;
        };

        led-2 {
            color = <0x3>;
            function = <0x77616e00>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0xe 0x1 >;
            linux,default-trigger = [706f6e302d726567697374726174696f6e00];
        };

        led-3 {
            color = <0x1>;
            function = <0x77616e00>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x10 0x1 >;
            linux,default-trigger = [706f6e302d6c6f7300];
        };

        led-internet {
            color = <0x3>;
            function = "wan-online";
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x5 0x1 >;
            linux,default-trigger = < 0x706f6e30 0x2d6f6e6c 0x696e6500 >;
        };

        led-wlan {
            color = <0x3>;
            function = "wlan";
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0xf 0x1 >;
            linux,default-trigger = [70687930726164696f00];
        };

        led-phone {
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x0 0x1 >;
            label = "blue:phone";
        };

        led-usb1 {
            color = <0x3>;
            function = <0x75736200>;
            function-enumerator = <0x1>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x6 0x1 >;
        };

        led-usb2 {
            color = <0x3>;
            function = <0x75736200>;
            function-enumerator = <0x2>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x8 0x1 >;
        };

        led-lan1 {
            color = <0x3>;
            function = <0x6c616e00>;
            function-enumerator = <0x1>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x2b 0x1 >;
        };

        led-lan2 {
            color = <0x3>;
            function = <0x6c616e00>;
            function-enumerator = <0x2>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x2c 0x1 >;
        };

        led-lan3 {
            color = <0x3>;
            function = <0x6c616e00>;
            function-enumerator = <0x3>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x2d 0x1 >;
        };

        led-lan4 {
            color = <0x3>;
            function = <0x6c616e00>;
            function-enumerator = <0x4>;
            gpios = < &{/soc/system-controller@1fbf0200/pinctrl} 0x2e 0x1 >;
        };
    };
};
