diff --git a/airoha-pon-daemons/src/src/oam/ctc.rs b/airoha-pon-daemons/src/src/oam/ctc.rs
index b029304..2d64b0c 100644
--- a/airoha-pon-daemons/src/src/oam/ctc.rs
+++ b/airoha-pon-daemons/src/src/oam/ctc.rs
@@ -128,6 +128,31 @@ impl CtcSession {
 
         let has_version_list = length > 7;
         if has_version_list {
+            // Some OLTs encode the selected version as a one-entry version
+            // list: OUI, 0x01, 0x01, OUI, version (length 11). Treat that as
+            // the selection instead of offering our list again forever.
+            if self.state == DiscoveryState::Offered
+                && length == 11
+                && tlv.get(2..5) == Some(&config.ctc_oui[..])
+                && tlv[5] == 1
+                && tlv[6] == 1
+                && tlv.get(7..10) == Some(&config.ctc_oui[..])
+            {
+                let version = tlv[10];
+                if config.ctc_versions.contains(&version) {
+                    self.state = DiscoveryState::Operational;
+                    self.selected_version = Some(version);
+                    return Ok(Some(vec![
+                        INFO_TYPE_ORGANIZATION_SPECIFIC,
+                        7,
+                        config.ctc_oui[0],
+                        config.ctc_oui[1],
+                        config.ctc_oui[2],
+                        1,
+                        version,
+                    ]));
+                }
+            }
             self.state = DiscoveryState::Offered;
             self.selected_version = None;
             let mut response = Writer::with_capacity(7 + config.ctc_versions.len() * 4);
