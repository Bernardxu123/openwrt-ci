# wugui-sub.conf.example — 复制为 /etc/wugui-sub.conf 并填入真实值
# chmod 600 /etc/wugui-sub.conf
WUGUI_EMAIL=you@example.com
WUGUI_PASSWORD=change-me
WUGUI_API=https://wgjsq08.vip/wuguiapi

# daed GraphQL（注意：daed 只监听 192.168.31.1:2023，不是 127.0.0.1）
DAED_URL=http://192.168.31.1:2023/graphql
DAED_USER=root
DAED_PASS=change-me
DAED_SUB_ID=Y3Vyc29yMw
DAED_SUB_TAG=乌龟
