#!/bin/sh /etc/rc.common
# DSH Pocket IPv6 反代（独立于 nginx-ssl 包自带的 uci 配置，避免 80/443 端口冲突）
# 部署位置：/etc/init.d/dsh-nginx
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/nginx -c /etc/dsh-nginx/nginx.conf -g "daemon off;"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/dsh-nginx/nginx.conf
    procd_close_instance
}

reload_service() {
    /usr/sbin/nginx -c /etc/dsh-nginx/nginx.conf -s reload
}
