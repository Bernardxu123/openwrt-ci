# =========================
# 系统服务直连
# =========================

pname(NetworkManager,systemd-resolved,dnsmasq)->must_direct
pname(ntpd,chronyd)->must_direct


# =========================
# 私网直连
# =========================

dip(geoip:private)->direct
domain(geosite:private)->direct


# =========================
# UDP协议治理
# 禁止QUIC，强制TCP代理
# =========================

l4proto(udp)&&dport(443)->block

# NTP校时
l4proto(udp)&&dport(123)->direct


# =========================
# 自建服务
# =========================

domain(290490.xyz)->direct


# =========================
# AI Studio 固定出口
# 2026-10-12 新增：aistudio.google.com 无法登录的修复
# =========================
# 背景：aistudio.google.com 原先不在任何域名规则里，其流量被
#   下面的 Google IPv6 规则（v6：2404:6800:4005:81x::）和
#   fallback（v4：142.250.197.x）送进轮换池（Media / proxy），
#   而 Google 对轮换池的机场出口 IP 不响应 aistudio
#   （PC 实测 6/6 超时；同一批出口访问 accounts.google.com 却
#   正常返回 302，说明是 Google 侧按 IP 信誉区别对待）。
#   新加坡2-自建 VPS 直连 aistudio 为 302（0.24s），故固定到 Stable。
# 覆盖域名（dae 普通条目 = 后缀匹配，同时罩住子域名）：
#   aistudio.google.com / makersuite.google.com          前端
#   alkalimakersuite-pa.clients6.google.com              API（含 2webchannel- 前缀）
#   alkalimakersuite-pa.googleapis.com                   API（172.217.x / 2001:4860:4840:: 池）
# 安全性：与 YouTube 全系域名的解析 IP 零交集（14 次解析实测对比），
#   不会把 YouTube 流量截到 Stable；本规则必须排在下面两条
#   Google IPv6 规则之前才能生效（它们按 IP 无条件命中）。
domain(aistudio.google.com,makersuite.google.com,alkalimakersuite-pa.clients6.google.com,alkalimakersuite-pa.googleapis.com)->Stable


# =========================
# Google IPv6 精准分流
# 华为IPv6 PD
# =========================

# Google Video CDN
sip("2408:820c::/16")&&dip("2404:6800::/32")->Media


# Google API / youtubei / Gemini相关
# 固定出口IP
sip("2408:820c::/16")&&dip("2001:4860::/32")->Stable


# =========================
# AI服务
# =========================

domain(generativelanguage.googleapis.com,ai.google.dev,gemini.google.com,bard.google.com)->AI

domain(geosite:openai,geosite:anthropic)->AI

domain(opencode.ai,oracle.com,oraclecloud.com,oci.oraclecloud.com,nvidia.com,workbuddy.ai)->AI


# =========================
# 流媒体
# =========================

domain(geosite:youtube,youtu.be,geosite:netflix,geosite:disney,geosite:spotify)->Media


# =========================
# Google IPv6兜底
# 无SNI情况
# =========================

dip("2404:6800::/32")->Media


# =========================
# 指定海外服务
# =========================

domain(stripo.email,justuno.com,mailchimp.com,freepik.com,joeyblog.net,googleapis.cn,services.googleapis.cn,xn--ngstr-lra8j.com,dl.google.com)->proxy


# =========================
# 中国大陆直连
# =========================

domain(geosite:cn)->direct

dip(geoip:cn)->direct


# =========================
# 默认代理
# =========================

fallback: proxy